+# Raye's own test of this plugin, in a directory of its own rather than in
+# autotests/: the packaging builds with BUILD_TESTING=OFF, because one of
+# the upstream tests never ends, and a Raye patch still has to be checked
+# where it is built. Turning the upstream directory on to reach one test
+# would bring that one back with it.
+#
+# Asked for here on purpose: with BUILD_TESTING off nothing else in the tree
+# pulls Qt6::Test in.
+find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test Quick)
+
+add_executable(tst_rayewheelinterceptor
+    tst_rayewheelinterceptor.cpp
+    ../wheelinterceptor.cpp)
+target_include_directories(tst_rayewheelinterceptor PRIVATE ..)
+target_link_libraries(tst_rayewheelinterceptor PRIVATE Qt6::Test Qt6::Quick)
+# the name begins with raye: that is what the package build runs
+add_test(NAME rayewheelinterceptor COMMAND tst_rayewheelinterceptor)
+set_tests_properties(rayewheelinterceptor PROPERTIES
+    TIMEOUT 60
+    ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
