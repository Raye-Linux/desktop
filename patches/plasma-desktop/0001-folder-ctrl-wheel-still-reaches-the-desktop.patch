+#pragma once
+
+#include <QObject>
+
+class RayeWheelInterceptorTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void handsAPlainWheelToTheDestinationWhenNothingBelowScrolls();
+    void letsAPlainWheelThroughToTheViewThatScrolls();
+    void keepsControlWheelForTheDestinationOverAScrollingView();
+    void leavesOtherModifiersToTheViewThatScrolls();
+    void doesNothingWithoutADestination();
+};
--- /dev/null
+++ b/containments/desktop/plugins/folder/raye-autotests/tst_rayewheelinterceptor.cpp
@@ -0,0 +1,115 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "tst_rayewheelinterceptor.h"
+#include "wheelinterceptor.h"
+
+#include <QTest>
+#include <QWheelEvent>
+
+QTEST_MAIN(RayeWheelInterceptorTest)
+
+namespace
+{
+// Counts the wheel events the interceptor forwards. A plain QObject is what
+// the interceptor is really given in the containment, so the test uses one.
+class Destination : public QObject
+{
+public:
+    int wheels = 0;
+    Qt::KeyboardModifiers lastModifiers = Qt::NoModifier;
+
+    bool event(QEvent *e) override
+    {
+        if (e->type() == QEvent::Wheel) {
+            ++wheels;
+            lastModifiers = static_cast<QWheelEvent *>(e)->modifiers();
+        }
+        return QObject::event(e);
+    }
+};
+
+QWheelEvent scrollDown(Qt::KeyboardModifiers modifiers)
+{
+    return QWheelEvent(QPointF(0, 0), QPointF(0, 0), QPoint(0, 0), QPoint(0, -120), Qt::NoButton, modifiers, Qt::NoScrollPhase, false);
+}
+
+// Sends the event the way the window does, through QQuickItem::event().
+// An event left unaccepted is one the window goes on to offer to the items
+// underneath; that is what "let through" means here.
+bool deliver(WheelInterceptor *interceptor, QWheelEvent &event)
+{
+    QCoreApplication::sendEvent(interceptor, &event);
+    return event.isAccepted();
+}
+}
+
+void RayeWheelInterceptorTest::handsAPlainWheelToTheDestinationWhenNothingBelowScrolls()
+{
+    WheelInterceptor interceptor;
+    Destination destination;
+    interceptor.setDestination(&destination);
+    interceptor.setScrollsBelow(false);
+
+    QWheelEvent event = scrollDown(Qt::NoModifier);
+    QVERIFY(deliver(&interceptor, event));
+    QCOMPARE(destination.wheels, 1);
+}
+
+void RayeWheelInterceptorTest::letsAPlainWheelThroughToTheViewThatScrolls()
+{
+    WheelInterceptor interceptor;
+    Destination destination;
+    interceptor.setDestination(&destination);
+    interceptor.setScrollsBelow(true);
+
+    QWheelEvent event = scrollDown(Qt::NoModifier);
+    QVERIFY(!deliver(&interceptor, event));
+    QCOMPARE(destination.wheels, 0);
+}
+
+void RayeWheelInterceptorTest::keepsControlWheelForTheDestinationOverAScrollingView()
+{
+    WheelInterceptor interceptor;
+    Destination destination;
+    interceptor.setDestination(&destination);
+    interceptor.setScrollsBelow(true);
+
+    QWheelEvent event = scrollDown(Qt::ControlModifier);
+    QVERIFY(deliver(&interceptor, event));
+    QCOMPARE(destination.wheels, 1);
+    QCOMPARE(destination.lastModifiers, Qt::ControlModifier);
+
+    // and with another modifier held alongside it
+    QWheelEvent both = scrollDown(Qt::ControlModifier | Qt::ShiftModifier);
+    QVERIFY(deliver(&interceptor, both));
+    QCOMPARE(destination.wheels, 2);
+}
+
+void RayeWheelInterceptorTest::leavesOtherModifiersToTheViewThatScrolls()
+{
+    WheelInterceptor interceptor;
+    Destination destination;
+    interceptor.setDestination(&destination);
+    interceptor.setScrollsBelow(true);
+
+    for (const Qt::KeyboardModifiers modifiers : {Qt::KeyboardModifiers(Qt::ShiftModifier), Qt::KeyboardModifiers(Qt::AltModifier), Qt::KeyboardModifiers(Qt::MetaModifier)}) {
+        QWheelEvent event = scrollDown(modifiers);
+        QVERIFY(!deliver(&interceptor, event));
+    }
+    QCOMPARE(destination.wheels, 0);
+}
+
+void RayeWheelInterceptorTest::doesNothingWithoutADestination()
+{
+    WheelInterceptor interceptor;
+    interceptor.setScrollsBelow(false);
+
+    QWheelEvent event = scrollDown(Qt::ControlModifier);
+    deliver(&interceptor, event);
+    // nothing to assert but that it did not crash
+    QVERIFY(interceptor.destination() == nullptr);
+}
