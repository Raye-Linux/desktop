+++ b/containments/desktop/plugins/folder/wheelinterceptor.cpp
@@ -31,8 +31,35 @@
     }
 }
 
+bool WheelInterceptor::scrollsBelow() const
+{
+    return m_scrollsBelow;
+}
+
+void WheelInterceptor::setScrollsBelow(bool scrollsBelow)
+{
+    if (m_scrollsBelow != scrollsBelow) {
+        m_scrollsBelow = scrollsBelow;
+
+        Q_EMIT scrollsBelowChanged();
+    }
+}
+
 void WheelInterceptor::wheelEvent(QWheelEvent *event)
 {
+    // When there is a view below that can scroll, a plain wheel belongs to it:
+    // let the event through rather than hand it to the destination, which
+    // would swallow the scrolling of a desktop that holds more icons than fit.
+    //
+    // Ctrl + wheel is the exception, because it is never a scroll anywhere: it
+    // is the gesture that changes a size, and the destination binds it. Any
+    // other modifier keeps the scrolling it has today; widening this to every
+    // modifier would silently take Shift + wheel away from the view below.
+    if (m_scrollsBelow && !(event->modifiers() & Qt::ControlModifier)) {
+        event->ignore();
+        return;
+    }
+
     if (m_destination) {
         QCoreApplication::sendEvent(m_destination, event);
     }
