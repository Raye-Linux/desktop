+++ b/debian/rules
@@ -6,6 +6,10 @@
 #l10npkgs_firstversion_ok := 4:17.08.3-3~
 #include /usr/share/pkg-kde-tools/qt-kde-team/2/l10n-packages.mk
 
+# DEB_HOST_GNU_TYPE: the name dh gives the build folder, which the Raye
+# tests are run from
+include /usr/share/dpkg/architecture.mk
+
 #DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
 #ifneq (,$(filter $(DEB_HOST_ARCH), armel armhf mips mipsel))
 #    export DEB_CFLAGS_MAINT_STRIP = -g
@@ -18,12 +22,22 @@
 	dh $@
 
 override_dh_auto_configure:
-	dh_auto_configure -- -DBUILD_TESTING=OFF
+	dh_auto_configure -- -DBUILD_TESTING=OFF -DRAYE_TESTING=ON
 
 override_dh_auto_test:
-	# Disable dh_auto_test, fourth test never ends
-	# xvfb-run -a dh_auto_test
-	:
+	# Upstream's own tests stay off, as they were: one of them never ends.
+	# Raye's do run. A patch of the Raye series changes how the desktop
+	# behaves, and a change nobody checks where it is built is a change
+	# that comes undone on the next rebase without a word.
+	#
+	# dh calls an override even under nocheck, so the skip is written here.
+ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
+	# --no-tests=error: ctest exits 0 when it finds nothing to run, so
+	# without it a series whose tests stopped being registered would build
+	# green for ever.
+	ctest --test-dir obj-$(DEB_HOST_GNU_TYPE) -R '^raye' \
+		--no-tests=error --output-on-failure
+endif
 
