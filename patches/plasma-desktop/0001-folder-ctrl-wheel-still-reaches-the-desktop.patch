+++ b/containments/desktop/package/contents/ui/FolderView.qml
@@ -1242,7 +1242,11 @@
         Folder.WheelInterceptor {
             anchors.fill: parent
 
-            enabled: root.isContainment && !gridView.overflowing
+            // Stays on even when the grid can scroll: it lets a plain wheel
+            // through to the grid and keeps Ctrl + wheel for the containment,
+            // which would otherwise lose its gesture on a crowded desktop.
+            enabled: root.isContainment
+            scrollsBelow: gridView.overflowing
             destination: root
         }
 
