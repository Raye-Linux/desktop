@@ -0,0 +1,103 @@
+// The desktop a new Raye account starts with: icons on the desktop, one
+// bar at the bottom with the Start button and the open apps in the middle,
+// the tray and the clock on the right. The other screens get their taskbar
+// from raye-taskbar-sync (raye-shell), started by KWin at login.
+//
+// This is the shell package's `defaultlayout` -- libplasma's Plasma/Shell
+// structure maps that key to contents/layout.js. It belongs to the desktop,
+// not to a look: switching between Raye Night and Raye Day, or to any other
+// colour scheme, leaves the layout alone. It used to live in the Raye
+// look-and-feel package, where it was read first and made the layout part
+// of the theme.
+//
+// It runs once, for an account that has no containments yet. A change that
+// existing accounts must also get goes in contents/updates/, which Plasma
+// runs once per account and records in kdeglobals [Updates] performed.
+
+var wallpaper = "file:///usr/share/wallpapers/Raye/";
+
+var all = desktops();
+for (var i = 0; i < all.length; ++i) {
+    var d = all[i];
+    d.wallpaperPlugin = "org.kde.image";
+    d.currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
+    d.writeConfig("Image", wallpaper);
+}
+
+// Right-click on the bar: Raye's short menu (Task Manager, Taskbar
+// settings) instead of Plasma's. Plasma reads it when a panel is made, so
+// it is written first. The menu comes with raye-shell, as sync.js does.
+if (fileExists("/usr/share/raye/taskbar/sync.js")) {
+    var actions = ConfigFile(ConfigFile("plasma-org.kde.plasma.desktop-appletsrc", "ActionPlugins"), "1");
+    actions.writeEntry("RightButton;NoModifier", "org.raye.desktopmenu");
+    // not a mouse button: it loads org.raye.taskbarpins with every panel,
+    // which keeps one list of pinned apps for all taskbars
+    actions.writeEntry("raye-taskbar-pins", "org.raye.taskbarpins");
+}
+
+var panel = new Panel;
+// Plasma puts a new panel on the screen with the pointer; the taskbar
+// with the clock and the tray goes on the main display
+panel.screen = 0;
+panel.location = "bottom";
+panel.height = 48;            // same height as the bar people know
+panel.hiding = "none";
+panel.floating = false;
+
+// Raye's own taskbar when raye-shell brings it: Start with search and
+// task view, the apps, the tray, the clock with the far corner. Its
+// settings (pins, alignment, search style...) live in rayeshellrc.
+var raye = knownWidgetTypes.indexOf("org.raye.start") >= 0
+        && knownWidgetTypes.indexOf("org.raye.taskbar") >= 0
+        && knownWidgetTypes.indexOf("org.raye.clock") >= 0;
+
+if (raye) {
+    panel.addWidget("org.raye.start");
+    panel.addWidget("org.raye.taskbar");
+    // the tray is tidied at first login by raye-tray-defaults, once Plasma
+    // has built it; raye-taskbar-sync takes its notifications item out
+    // (the clock shows the notifications)
+    panel.addWidget("org.kde.plasma.systemtray");
+    panel.addWidget("org.raye.clock");
+} else {
+    // the two spacers keep Start and the tasks centred
+    panel.addWidget("org.kde.plasma.panelspacer");
+
+    var start = panel.addWidget("org.kde.plasma.kickoff");
+    start.currentConfigGroup = ["General"];
+    start.writeConfig("icon", "raye-eye");
+    start.writeConfig("favoritesPortedToKAstats", "true");
+    // like the Start menu people know: pinned apps as a grid, all apps as a
+    // list, power buttons with their names
+    start.writeConfig("favoritesDisplay", "0");
+    start.writeConfig("applicationsDisplay", "1");
+    start.writeConfig("showActionButtonCaptions", "true");
+    start.writeConfig("primaryActions", "1");
+
+    var tasks = panel.addWidget("org.kde.plasma.icontasks");
+    tasks.currentConfigGroup = ["General"];
+    // Firefox itself rather than "the default browser": when Firefox makes
+    // itself the default it registers an entry with no icon, and the pin
+    // would turn into a blank page with a second Firefox button next to it
+    tasks.writeConfig("launchers", [
+        "applications:org.kde.dolphin.desktop",
+        applicationExists("firefox.desktop") ? "applications:firefox.desktop" : "preferred://browser",
+        "applications:org.raye.store.desktop",
+        "applications:org.raye.settings.desktop"
+    ].join(","));
+    tasks.writeConfig("iconSpacing", "1");   // 1 is the tightest, like the bar people know
+    tasks.writeConfig("maxStripes", "1");
+    tasks.writeConfig("showToolTips", "true");
+
+    panel.addWidget("org.kde.plasma.panelspacer");
+    // the tray is tidied at first login by raye-tray-defaults, once Plasma
+    // has built it
+    panel.addWidget("org.kde.plasma.systemtray");
+
+    var clock = panel.addWidget("org.kde.plasma.digitalclock");
+    clock.currentConfigGroup = ["Appearance"];
+    clock.writeConfig("showDate", "true");
+    clock.writeConfig("dateFormat", "shortDate");
+
+    panel.addWidget("org.kde.plasma.showdesktop");
+}
