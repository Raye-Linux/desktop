@@ -0,0 +1,116 @@
+// A stand-in for the Plasma desktop scripting API, as much of it as the
+// shell package's default layout uses. Values come back as strings, the way
+// KConfig hands them back, and ConfigFile keeps real groups so what the
+// script wrote can be read back after it has run.
+
+var __files = {};        // file -> group path -> key -> value
+var __present = {};      // what fileExists() finds
+var __printed = [];
+var __nextId = 1;
+var __panels = [];
+var __desktops = [];
+var screenCount = 1;
+var knownWidgetTypes = ["org.kde.plasma.kickoff", "org.kde.plasma.icontasks",
+                        "org.kde.plasma.systemtray", "org.kde.plasma.digitalclock",
+                        "org.kde.plasma.panelspacer", "org.kde.plasma.showdesktop",
+                        "org.raye.start", "org.raye.taskbar", "org.raye.clock"];
+
+function print(text) { __printed.push(String(text)); }
+function fileExists(path) { return __present[path] === true; }
+function applicationExists(name) { return name === "firefox.desktop"; }
+function defaultApplication(name) { return "firefox.desktop"; }
+
+// ConfigFile(file, group) and ConfigFile(parent, subgroup), as Plasma's own
+// update scripts use them
+function ConfigFile(a, b) {
+    var file, path;
+    if (typeof a === "string") {
+        file = a;
+        path = [b];
+    } else {
+        file = a.__file;
+        path = a.__path.concat([b]);
+    }
+    if (!__files[file])
+        __files[file] = {};
+    var key = path.join("\u0000");
+    if (!__files[file][key])
+        __files[file][key] = {};
+    var store = __files[file][key];
+    return {
+        __file: file,
+        __path: path,
+        // every group one level under this one, as KConfig lists them
+        get groupList() {
+            var out = [];
+            var mine = path.join("\u0000") + "\u0000";
+            for (var g in __files[file]) {
+                if (g.indexOf(mine) === 0) {
+                    var rest = g.substring(mine.length);
+                    if (rest.indexOf("\u0000") === -1 && out.indexOf(rest) === -1)
+                        out.push(rest);
+                }
+            }
+            return out;
+        },
+        readEntry: function (k, def) { return k in store ? store[k] : def; },
+        writeEntry: function (k, v) { store[k] = String(v); },
+        deleteEntry: function (k) { delete store[k]; },
+        get keyList() { return Object.keys(store); }
+    };
+}
+
+function __widget(plugin) {
+    return {
+        id: __nextId++,
+        plugin: plugin,
+        type: plugin,
+        cfg: {},
+        currentConfigGroup: [],
+        readConfig: function (k, def) {
+            var g = this.cfg[this.currentConfigGroup.join("/")] || {};
+            return k in g ? g[k] : def;
+        },
+        writeConfig: function (k, v) {
+            var p = this.currentConfigGroup.join("/");
+            if (!this.cfg[p])
+                this.cfg[p] = {};
+            this.cfg[p][k] = String(v);
+        }
+    };
+}
+
+function Panel() {
+    var p = __widget("org.kde.panel");
+    p.widgets = [];
+    p.addWidget = function (plugin) {
+        var w = __widget(plugin);
+        this.widgets.push(w);
+        return w;
+    };
+    __panels.push(p);
+    return p;
+}
+
+function desktops() { return __desktops; }
+
+// the scene sets this up: one Folder view desktop per screen, with the
+// containment groups Plasma would already have written
+function __scene(plugins) {
+    __desktops = [];
+    for (var i = 0; i < plugins.length; ++i) {
+        var d = __widget(plugins[i]);
+        __desktops.push(d);
+        ConfigFile(ConfigFile("plasma-org.kde.plasma.desktop-appletsrc", "Containments"),
+                   String(d.id)).writeEntry("plugin", plugins[i]);
+    }
+}
+
+// what the layout left in [ActionPlugins][group] for a trigger. The group
+// is a containment TYPE for anything libplasma reads -- 0 desktop, 1 panel
+// -- so passing a containment id here is how a test asks whether the
+// layout wrote somewhere nothing reads.
+function __action(group, trigger) {
+    return ConfigFile(ConfigFile("plasma-org.kde.plasma.desktop-appletsrc", "ActionPlugins"),
+                      String(group)).readEntry(trigger, "");
+}
--- /dev/null
+++ b/desktoppackage/autotests/tst_rayelayout.cpp
@@ -0,0 +1,139 @@
+/*
+    The shell package's default layout (contents/layout.js) against a
+    stand-in of Plasma's desktop scripting API: that it runs, what it puts
+    on the taskbar, what it does when the Raye shell is not installed, and
+    that it binds no containment action by containment id.
+
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QFile>
+#include <QJSEngine>
+#include <QTest>
+
+using namespace Qt::StringLiterals;
+
+class RayeLayoutTest : public QObject
+{
+    Q_OBJECT
+
+private:
+    static QString read(const QString &path)
+    {
+        QFile f(path);
+        if (!f.open(QIODevice::ReadOnly)) {
+            qFatal("cannot read %s", qPrintable(path));
+        }
+        return QString::fromUtf8(f.readAll());
+    }
+
+    // the mock, then the scene, then the layout; returns the value of `check`
+    static QString run(const QString &scene, const QString &check)
+    {
+        QJSEngine engine;
+        const QString mockPath = QStringLiteral(RAYE_LAYOUT_MOCK);
+        const QString layoutPath = QStringLiteral(RAYE_LAYOUT_JS);
+        QJSValue r = engine.evaluate(read(mockPath), mockPath);
+        if (r.isError()) {
+            return u"mock: "_s + r.toString();
+        }
+        r = engine.evaluate(scene);
+        if (r.isError()) {
+            return u"scene: "_s + r.toString();
+        }
+        r = engine.evaluate(read(layoutPath), layoutPath);
+        if (r.isError()) {
+            return u"layout: "_s + r.toString() + u" line "_s + r.property(u"lineNumber"_s).toString();
+        }
+        r = engine.evaluate(check);
+        if (r.isError()) {
+            return u"check: "_s + r.toString();
+        }
+        return r.toString();
+    }
+
+    // one Folder view desktop, the Raye shell installed
+    static QString withTheShell()
+    {
+        return u"__scene(['org.kde.plasma.folder']);"
+               "__present['/usr/share/raye/taskbar/sync.js'] = true;"_s;
+    }
+
+    // the same, with none of the Raye applets available to the shell
+    static QString withoutTheRayeApplets()
+    {
+        return u"__scene(['org.kde.plasma.folder']);"
+               "knownWidgetTypes = ['org.kde.plasma.kickoff', 'org.kde.plasma.icontasks',"
+               "    'org.kde.plasma.systemtray', 'org.kde.plasma.digitalclock',"
+               "    'org.kde.plasma.panelspacer', 'org.kde.plasma.showdesktop'];"_s;
+    }
+
+private Q_SLOTS:
+    void theLayoutRuns()
+    {
+        QCOMPARE(run(withTheShell(), u"__panels.length"_s), u"1"_s);
+    }
+
+    void theTaskbarSitsAtTheBottomOfTheFirstScreen()
+    {
+        QCOMPARE(run(withTheShell(), u"__panels[0].location"_s), u"bottom"_s);
+        QCOMPARE(run(withTheShell(), u"String(__panels[0].screen)"_s), u"0"_s);
+    }
+
+    void theTaskbarKeepsItsWidgets()
+    {
+        const QString widgets = run(withTheShell(), u"__panels[0].widgets.map(function (w) { return w.plugin; }).join(',')"_s);
+        QCOMPARE(widgets, u"org.raye.start,org.raye.taskbar,org.kde.plasma.systemtray,org.raye.clock"_s);
+    }
+
+    void aDesktopWithoutTheRayeAppletsStillGetsAUsableTaskbar()
+    {
+        // the fall-back branch: Plasma's own widgets, arranged like the bar
+        // people know. A desktop with no taskbar at all is the one outcome
+        // this script may never produce.
+        const QString widgets = run(withoutTheRayeApplets(), u"__panels[0].widgets.map(function (w) { return w.plugin; }).join(',')"_s);
+        QVERIFY2(widgets.contains(u"kickoff"_s), qPrintable(widgets));
+        QVERIFY2(widgets.contains(u"icontasks"_s), qPrintable(widgets));
+        QVERIFY2(widgets.contains(u"digitalclock"_s), qPrintable(widgets));
+    }
+
+    void theDesktopGetsTheRayeWallpaper()
+    {
+        QCOMPARE(run(withTheShell(), u"__desktops[0].wallpaperPlugin"_s), u"org.kde.image"_s);
+        QCOMPARE(run(withTheShell(), u"__desktops[0].cfg['Wallpaper/org.kde.image/General']['Image']"_s),
+                 u"file:///usr/share/wallpapers/Raye/"_s);
+    }
+
+    void theTaskbarMenuIsRayesWhenTheShellIsInstalled()
+    {
+        // [ActionPlugins][1]: 1 is Plasma::Containment::Type::Panel. The
+        // group is keyed by the containment TYPE, never by a containment id.
+        QCOMPARE(run(withTheShell(), u"__action('1', 'RightButton;NoModifier')"_s), u"org.raye.desktopmenu"_s);
+        QCOMPARE(run(withTheShell(), u"__action('1', 'raye-taskbar-pins')"_s), u"org.raye.taskbarpins"_s);
+    }
+
+    void withoutTheRayeShellTheTaskbarKeepsPlasmasMenu()
+    {
+        // no guard file: the layout must not point the menu at a plugin that
+        // is not there, which would leave the taskbar with no menu at all
+        QCOMPARE(run(u"__scene(['org.kde.plasma.folder']);"_s, u"__action('1', 'RightButton;NoModifier')"_s), QString());
+    }
+
+    void theLayoutBindsNoActionByContainmentId()
+    {
+        // A group keyed by an id is read by nothing. And a group keyed by a
+        // TYPE that holds a single key makes libplasma skip the whole
+        // defaults block of the shell package, which would cost the desktop
+        // its right-click menu and its middle-click paste.
+        const QString scene = u"__scene(['org.kde.plasma.folder', 'org.kde.desktopcontainment']);"
+                              "__present['/usr/share/raye/taskbar/sync.js'] = true;"_s;
+        QCOMPARE(run(scene, u"__action(String(__desktops[0].id), 'wheel:Vertical;ControlModifier')"_s), QString());
+        QCOMPARE(run(scene, u"__action(String(__desktops[1].id), 'wheel:Vertical;ControlModifier')"_s), QString());
+        QCOMPARE(run(scene, u"__action(String(__panels[0].id), 'RightButton;NoModifier')"_s), QString());
+    }
+};
+
+QTEST_MAIN(RayeLayoutTest)
+#include "tst_rayelayout.moc"
