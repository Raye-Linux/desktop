+# The shell package's default layout is a script, and it is what every new
+# account runs. Running it against a stand-in of the scripting API is the
+# only way to test it without a session, and it runs in the package build.
+
+# Asked for here on purpose: the packaging configures with BUILD_TESTING=OFF,
+# so nothing else in the tree pulls Qt6::Test in and the targets below would
+# have nothing to link against.
+find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test Qml)
+
+add_executable(tst_rayelayout tst_rayelayout.cpp)
+target_link_libraries(tst_rayelayout PRIVATE Qt6::Test Qt6::Qml)
+target_compile_definitions(tst_rayelayout PRIVATE
+    RAYE_LAYOUT_MOCK="${CMAKE_CURRENT_SOURCE_DIR}/layout-mock.js"
+    RAYE_LAYOUT_JS="${CMAKE_CURRENT_SOURCE_DIR}/../contents/layout.js")
+add_test(NAME rayelayout COMMAND tst_rayelayout)
+set_tests_properties(rayelayout PROPERTIES
+    TIMEOUT 60
+    ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
+
