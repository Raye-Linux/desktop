+using namespace RayeDragGhost;
+
+static QImage filled(const QSize &size, const QColor &color, qreal dpr = 1.0)
+{
+    QImage image(size * dpr, QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(dpr);
+    image.fill(color);
+    return image;
+}
+
+static Piece piece(const QPoint &cellAt, const QColor &color, bool withLabel = true, qreal dpr = 1.0)
+{
+    Piece p;
+    p.cell = QRect(cellAt, QSize(96, 96));
+    p.icon = QRect(cellAt + QPoint(24, 8), QSize(48, 48));
+    p.iconImage = filled(p.icon.size(), color, dpr);
+    if (withLabel) {
+        p.label = QRect(cellAt + QPoint(8, 60), QSize(80, 20));
+        p.labelImage = filled(p.label.size(), Qt::green, dpr);
+    }
+    return p;
+}
+
+// colour of a logical pixel, whatever the ratio of the image
+static QColor at(const Ghost &ghost, const QPoint &logical)
+{
+    const qreal dpr = ghost.image.devicePixelRatio();
+    return ghost.image.pixelColor((QPointF(logical) * dpr).toPoint());
+}
+
+static int countNear(const QImage &image, const QColor &want)
+{
+    int n = 0;
+    for (int y = 0; y < image.height(); ++y) {
+        for (int x = 0; x < image.width(); ++x) {
+            const QColor c = image.pixelColor(x, y);
+            if (c.alpha() > 240 && qAbs(c.red() - want.red()) < 8 && qAbs(c.green() - want.green()) < 8 && qAbs(c.blue() - want.blue()) < 8) {
+                ++n;
+            }
+        }
+    }
+    return n;
+}
+
+class RayeDragGhostTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void oneIconAndItsName();
+    void seeThrough();
+    void pointerStaysOnTheIcon();
+    void severalMakeAStack();
+    void stackShowsTheCount();
+    void pressedOneIsOnTop();
+    void sharpOnHiDpi();
+    void emptyPiecesAreSkipped();
+    void countText();
+};
+
+void RayeDragGhostTest::oneIconAndItsName()
+{
+    const Piece p = piece(QPoint(100, 200), Qt::red);
+    const Ghost g = compose({p}, QPoint(140, 230), Qt::blue, Qt::white);
+    // icon and label together, nothing else: no frame, no hover button
+    QCOMPARE(g.image.size(), (p.icon | p.label).size());
+    QVERIFY(at(g, p.icon.center() - (p.icon | p.label).topLeft()).red() > 0);
+    QVERIFY(at(g, p.label.center() - (p.icon | p.label).topLeft()).green() > 0);
+}
+
+void RayeDragGhostTest::seeThrough()
+{
+    const Piece p = piece(QPoint(0, 0), Qt::red);
+    const Ghost g = compose({p}, QPoint(40, 30), Qt::blue, Qt::white);
+    // 70 %, as on Windows: enough to read, and the desktop shows through
+    const int alpha = at(g, p.icon.center() - (p.icon | p.label).topLeft()).alpha();
+    QVERIFY2(qAbs(alpha - 178) <= 2, qPrintable(QString::number(alpha)));
+}
+
+void RayeDragGhostTest::pointerStaysOnTheIcon()
+{
+    const Piece p = piece(QPoint(300, 120), Qt::red);
+    const QPoint pointer(330, 140);
+    const Ghost g = compose({p}, pointer, Qt::blue, Qt::white);
+    QCOMPARE(g.hotSpot, pointer - (p.icon | p.label).topLeft());
+    QVERIFY(at(g, g.hotSpot).red() > 0);
+}
+
+void RayeDragGhostTest::severalMakeAStack()
+{
+    const QList<Piece> pieces{piece(QPoint(0, 0), Qt::red), piece(QPoint(0, 100), Qt::yellow), piece(QPoint(0, 200), Qt::cyan)};
+    const Ghost g = compose(pieces, QPoint(40, 30), Qt::blue, Qt::white);
+    // a stack the size of about one icon, not the three cells in a column
+    QVERIFY(g.image.height() < 2 * pieces.first().icon.height());
+    QVERIFY(g.image.width() < 2 * pieces.first().icon.width());
+    // names are left out of a stack
+    QCOMPARE(countNear(g.image, Qt::green), 0);
+}
+
+void RayeDragGhostTest::stackShowsTheCount()
+{
+    const QColor accent(123, 60, 255);
+    const QList<Piece> pieces{piece(QPoint(0, 0), Qt::red), piece(QPoint(0, 100), Qt::yellow)};
+    const Ghost g = compose(pieces, QPoint(40, 30), accent, Qt::white);
+    QVERIFY(countNear(g.image, accent) > 40);
+    const Ghost one = compose({pieces.first()}, QPoint(40, 30), accent, Qt::white);
+    QCOMPARE(countNear(one.image, accent), 0);
+}
+
+void RayeDragGhostTest::pressedOneIsOnTop()
+{
+    const QList<Piece> pieces{piece(QPoint(0, 0), Qt::red), piece(QPoint(0, 100), Qt::yellow), piece(QPoint(100, 0), Qt::cyan)};
+    const QPoint pointer(140, 30); // over the third one
+    const Ghost g = compose(pieces, pointer, Qt::blue, Qt::white);
+    const QColor under = at(g, g.hotSpot);
+    QVERIFY(under.green() > 0 && under.blue() > 0 && under.red() == 0);
+    // and the pointer is on the same spot of it as when it was pressed:
+    // the icon starts exactly as far up and left of the hot spot as before
+    const QRect top = pieces.at(2).icon;
+    const QPoint corner = g.hotSpot - (pointer - top.topLeft());
+    QVERIFY(at(g, corner).blue() > 0);
+    QCOMPARE(at(g, corner - QPoint(0, 1)).alpha(), 0);
+}
+
+void RayeDragGhostTest::sharpOnHiDpi()
+{
+    const Piece p = piece(QPoint(0, 0), Qt::red, true, 2.0);
+    const Ghost g = compose({p}, QPoint(40, 30), Qt::blue, Qt::white);
+    QCOMPARE(g.image.devicePixelRatio(), 2.0);
+    QCOMPARE(g.image.size(), (p.icon | p.label).size() * 2);
+}
+
+void RayeDragGhostTest::emptyPiecesAreSkipped()
+{
+    Piece empty;
+    empty.cell = QRect(0, 0, 96, 96);
+    QVERIFY(compose({empty}, QPoint(10, 10), Qt::blue, Qt::white).image.isNull());
+    const Piece p = piece(QPoint(0, 100), Qt::red);
+    const Ghost g = compose({empty, p}, QPoint(10, 10), Qt::blue, Qt::white);
+    // one real icon left: drawn alone, with its name, no count
+    QCOMPARE(g.image.size(), (p.icon | p.label).size());
+}
+
+void RayeDragGhostTest::countText()
+{
+    QCOMPARE(RayeDragGhost::countText(2), QStringLiteral("2"));
+    QCOMPARE(RayeDragGhost::countText(99), QStringLiteral("99"));
+    QCOMPARE(RayeDragGhost::countText(250), QStringLiteral("99+"));
+}
+
+QTEST_MAIN(RayeDragGhostTest)
