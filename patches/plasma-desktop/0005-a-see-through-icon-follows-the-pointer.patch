+// icon and its name, see-through, or a small stack with a count when there
+// are several. Kept apart from FolderModel so it can be tested on its own.
+namespace RayeDragGhost
+{
+// how opaque the copy under the pointer is
+constexpr qreal ghostOpacity = 0.7;
+// At most this many icons are drawn in the stack, the rest only counted.
+constexpr int stackDepth = 3;
+
+struct Piece {
+    QRect cell; // the whole delegate, finds the icon under the pointer
+    QRect icon;
+    QImage iconImage;
+    QRect label;
+    QImage labelImage;
+};
+
+struct Ghost {
+    QImage image;
+    QPoint hotSpot;
+};
+
+// Pieces and pointer in the same coordinates. Empty pieces are skipped.
+Ghost compose(const QList<Piece> &pieces, const QPoint &pointer, const QColor &badge, const QColor &badgeText);
+
+// "3", or "99+" past that
+QString countText(int count);
