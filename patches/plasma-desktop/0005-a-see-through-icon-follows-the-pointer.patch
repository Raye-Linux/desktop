+QString countText(int count)
+{
+    return count > 99 ? QStringLiteral("99+") : QString::number(count);
+}
+
+static qreal ratioOf(const QList<Piece> &pieces)
+{
+    qreal dpr = 1.0;
+    for (const Piece &p : pieces) {
+        dpr = std::max({dpr, p.iconImage.devicePixelRatio(), p.labelImage.devicePixelRatio()});
+    }
+    return dpr;
+}
+
+Ghost compose(const QList<Piece> &all, const QPoint &pointer, const QColor &badge, const QColor &badgeText)
+{
+    QList<Piece> pieces;
+    for (const Piece &p : all) {
+        if (!p.iconImage.isNull() && !p.icon.isEmpty()) {
+            pieces.append(p);
+        }
+    }
+    if (pieces.isEmpty()) {
+        return {};
+    }
+
+    // the one pressed goes on top, so the pointer stays on the spot of it
+    // that was grabbed
+    auto pressed = std::find_if(pieces.begin(), pieces.end(), [&](const Piece &p) {
+        return p.cell.contains(pointer);
+    });
+    if (pressed != pieces.begin() && pressed != pieces.end()) {
+        std::rotate(pieces.begin(), pressed, pressed + 1);
+    }
+
+    const Piece &top = pieces.first();
+    const bool stack = pieces.size() > 1;
+    const int behind = std::min<int>(pieces.size(), stackDepth) - 1;
+    const int step = std::max(4, top.icon.width() / 12);
+
+    QRectF bounds = top.icon;
+    if (!stack && !top.labelImage.isNull()) {
+        bounds |= top.label;
+    }
+    // the icons behind peek out up and to the right
+    bounds |= QRectF(top.icon).translated(behind * step, -behind * step);
+
+    QRectF pill;
+    QString text;
+    QFont font = QGuiApplication::font();
+    if (stack) {
+        text = countText(pieces.size());
+        font.setBold(true);
+        font.setPixelSize(std::max(10, top.icon.height() / 4));
+        const QFontMetricsF metrics(font);
+        const qreal h = std::ceil(metrics.height() + 4);
+        const qreal w = std::max(h, std::ceil(metrics.horizontalAdvance(text) + h * 0.6));
+        // sits on the bottom right corner of the top icon, half outside it
+        pill = QRectF(top.icon.right() + 1 - w * 0.6, top.icon.bottom() + 1 - h * 0.6, w, h);
+        bounds |= pill;
+    }
+
+    const QRect frame = bounds.toAlignedRect();
+    const qreal dpr = ratioOf(pieces);
+
+    Ghost ghost;
+    ghost.image = QImage(frame.size() * dpr, QImage::Format_ARGB32_Premultiplied);
+    ghost.image.setDevicePixelRatio(dpr);
+    ghost.image.fill(Qt::transparent);
+    ghost.hotSpot = pointer - frame.topLeft();
+
+    // drawn whole first and faded once, so the top icon hides the ones
+    // behind it instead of showing them through
+    QImage layer(ghost.image.size(), QImage::Format_ARGB32_Premultiplied);
+    layer.setDevicePixelRatio(dpr);
+    layer.fill(Qt::transparent);
+    {
+        QPainter painter(&layer);
+        painter.setRenderHint(QPainter::SmoothPixmapTransform);
+        painter.translate(-frame.topLeft());
+        for (int i = behind; i >= 0; --i) {
+            // every icon of the stack takes the size of the top one
+            painter.drawImage(QRectF(top.icon).translated(i * step, -i * step), pieces.at(i).iconImage);
+        }
+        if (!stack && !top.labelImage.isNull()) {
+            painter.drawImage(QRectF(top.label), top.labelImage);
+        }
+    }
+
+    QPainter painter(&ghost.image);
+    painter.setOpacity(ghostOpacity);
+    painter.drawImage(QPointF(0, 0), layer);
+    painter.translate(-frame.topLeft());
+
+    if (stack) {
+        painter.setOpacity(1.0);
+        painter.setRenderHint(QPainter::Antialiasing);
+        QPainterPath path;
+        path.addRoundedRect(pill, pill.height() / 2, pill.height() / 2);
+        painter.fillPath(path, badge);
+        painter.setFont(font);
+        painter.setPen(badgeText);
+        painter.drawText(pill, Qt::AlignCenter, text);
+    }
+
+    return ghost;
+}
+
