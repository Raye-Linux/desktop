@@ -0,0 +1,27 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QByteArray>
+#include <QObject>
+
+class RayeMenuPrefixTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void init();
+    void cleanup();
+
+    void namesTheMenuFileRayeInstalls();
+    void putsThePrefixInTheSessionsEnvironment();
+    void replacesWhatTheSessionInherited();
+
+private:
+    QByteArray m_inherited;
+    bool m_wasSet = false;
+};
--- /dev/null
+++ b/startkde/raye-autotests/tst_rayemenuprefix.cpp
@@ -0,0 +1,66 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "tst_rayemenuprefix.h"
+#include "rayemenuprefix.h"
+
+#include <QTest>
+
+// No window and no D-Bus: the helper is a value and a qputenv.
+QTEST_GUILESS_MAIN(RayeMenuPrefixTest)
+
+void RayeMenuPrefixTest::init()
+{
+    // The cases set a real environment variable, so each one gets the
+    // environment it expects and gives back the one it was handed: a case
+    // that leaked its value into the next would make the order of the cases
+    // part of the result.
+    m_wasSet = qEnvironmentVariableIsSet("XDG_MENU_PREFIX");
+    m_inherited = qgetenv("XDG_MENU_PREFIX");
+    qunsetenv("XDG_MENU_PREFIX");
+}
+
+void RayeMenuPrefixTest::cleanup()
+{
+    if (m_wasSet) {
+        qputenv("XDG_MENU_PREFIX", m_inherited);
+    } else {
+        qunsetenv("XDG_MENU_PREFIX");
+    }
+}
+
+void RayeMenuPrefixTest::namesTheMenuFileRayeInstalls()
+{
+    // The prefix goes straight in front of the file name, so the dash is part
+    // of the value. Without it the session asks for rayeapplications.menu,
+    // which nothing installs, and falls back in silence.
+    QCOMPARE(rayeMenuPrefix() + "applications.menu", QByteArrayLiteral("raye-applications.menu"));
+}
+
+void RayeMenuPrefixTest::putsThePrefixInTheSessionsEnvironment()
+{
+    QVERIFY(!qEnvironmentVariableIsSet("XDG_MENU_PREFIX"));
+    setRayeMenuPrefix();
+    QCOMPARE(qgetenv("XDG_MENU_PREFIX"), rayeMenuPrefix());
+}
+
+void RayeMenuPrefixTest::replacesWhatTheSessionInherited()
+{
+    // 🚨 The property the patch exists for. Everything outside the source --
+    // a session environment script, a profile snippet, the login manager,
+    // systemd's own environment -- has already run by the time
+    // setupPlasmaEnvironment() is reached, and a helper that only filled the
+    // variable in when it was empty would hand the desktop whichever of them
+    // spoke last. It takes the variable, every time.
+    qputenv("XDG_MENU_PREFIX", QByteArrayLiteral("plasma-"));
+    setRayeMenuPrefix();
+    QCOMPARE(qgetenv("XDG_MENU_PREFIX"), rayeMenuPrefix());
+
+    // and not only over Plasma's own value
+    qputenv("XDG_MENU_PREFIX", QByteArrayLiteral("gnome-"));
+    setRayeMenuPrefix();
+    QCOMPARE(qgetenv("XDG_MENU_PREFIX"), rayeMenuPrefix());
+}
