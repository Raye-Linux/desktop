 #include "klookandfeelmanager.h"
 #include "lookandfeelsettings.h"
+#include "rayemenuprefix.h"
 
 using namespace Qt::StringLiterals;
 
@@ -407,7 +408,15 @@
 
     qputenv("KDE_APPLICATIONS_AS_SCOPE", "1");
 
-    qputenv("XDG_MENU_PREFIX", "plasma-");
+    // Raye's own application categories, and this is the only place that can
+    // choose them. 🚨 The line that stood here overwrote XDG_MENU_PREFIX
+    // unconditionally, and it runs after every mechanism outside the source:
+    // runEnvironmentScripts() is called before this function in both entry
+    // points, systemd's and D-Bus's environments are only read afterwards,
+    // and importSystemdEnvrionment() skips every XDG_ name. So Raye's menu
+    // file was installed, correct and never read, and no script could have
+    // fixed it. See startkde/rayemenuprefix.h.
+    setRayeMenuPrefix();
 
     // Add kdedefaults dir to allow config defaults overriding from a writable location
     QByteArray currentConfigDirs = qgetenv("XDG_CONFIG_DIRS");
--- /dev/null
+++ b/startkde/rayemenuprefix.h
@@ -0,0 +1,42 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QByteArray>
+#include <QtEnvironmentVariables>
+
+/**
+ * The prefix of the XDG application menu a Raye session reads.
+ *
+ * The desktop-menu specification puts the prefix straight in front of the
+ * file name, so the trailing '-' is part of the value and not a separator the
+ * reader adds: "raye-" names menus/raye-applications.menu, which is the file
+ * Raye installs. Spelled without the dash it would name rayeapplications.menu,
+ * KSycoca would find nothing and fall back to another menu without a word --
+ * which is the failure this whole patch is about, arrived at from a typo
+ * instead of from an ordering.
+ */
+inline QByteArray rayeMenuPrefix()
+{
+    return QByteArrayLiteral("raye-");
+}
+
+/**
+ * Puts that prefix in the session's environment.
+ *
+ * 🚨 It REPLACES whatever the session inherited, deliberately, because that is
+ * the behaviour of the line it stands in for. Honouring an inherited value
+ * instead would make which categories the desktop shows depend on whatever a
+ * profile snippet, a login manager or a leftover user script happened to
+ * export -- a desktop quietly showing another one's menu, with nothing to say
+ * so. A deterministic prefix is worth more here than an escape hatch nobody
+ * asked for.
+ */
+inline void setRayeMenuPrefix()
+{
+    qputenv("XDG_MENU_PREFIX", rayeMenuPrefix());
+}
