+++ b/startkde/raye-autotests/CMakeLists.txt
@@ -0,0 +1,22 @@
+# Raye's own test of the session's menu prefix, in a directory of its own
+# rather than in an upstream autotests/: the packaging builds with
+# BUILD_TESTING=OFF and empties dh_auto_test, and a Raye patch still has to be
+# checked where it is built.
+#
+# Qt6::Test is asked for here on purpose: with BUILD_TESTING off nothing else
+# in the tree pulls it in.
+find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test)
+
+# rayemenuprefix.h is header-only, so the test needs none of startplasma's
+# objects -- and must not have them: setupPlasmaEnvironment() writes in the
+# account's configuration directory, loads a look-and-feel package and talks to
+# D-Bus, none of which a build-time test may do. What the call site does is
+# checked by reading the source instead, in desktop/tests/test_menu_prefix.py.
+add_executable(tst_rayemenuprefix tst_rayemenuprefix.cpp)
+target_include_directories(tst_rayemenuprefix PRIVATE ..)
+target_link_libraries(tst_rayemenuprefix PRIVATE Qt6::Test)
+# the name begins with raye: that is what the package build runs
+add_test(NAME rayemenuprefix COMMAND tst_rayemenuprefix)
+set_tests_properties(rayemenuprefix PROPERTIES
+    TIMEOUT 60
+    ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
