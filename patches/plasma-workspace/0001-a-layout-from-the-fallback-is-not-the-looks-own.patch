+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <KPackage/Package>
+
+#include <QString>
+
+/**
+ * The layout script the active look-and-feel package really ships, and an
+ * empty string when it ships none -- so that the shell package's own
+ * `defaultlayout` is reached instead.
+ *
+ * 🚨 KPackage::Package::filePath() answers out of the package's *fallback*
+ * when the active package has no such file of its own, and
+ * shell/packageplugins/lookandfeel gives every look-and-feel package but
+ * org.kde.breeze.desktop a fallback to org.kde.breeze.desktop. All three
+ * Breeze packages ship layouts/org.kde.plasma.desktop-layout.js, so asking
+ * the active package for a layout it does not have is answered Breeze's --
+ * and because that answer is not empty, the `defaultlayout` of the shell
+ * package is never consulted at all.
+ *
+ * ⚠️ The emptiness of path() has to be tested on its own:
+ * QString::startsWith(QString()) is true for every string, and an invalid
+ * package has an empty path() while filePath() still answers out of the
+ * fallback. Measured: without that test the fallback's layout comes through.
+ *
+ * Package::path() is canonical and always ends in '/', and filePath() builds
+ * its answer by prepending it, so the prefix test is exact: no path outside
+ * the package directory can begin with it.
+ */
+inline QString ownLookAndFeelLayout(const KPackage::Package &lookAndFeel, const QString &fileName)
+{
+    if (!lookAndFeel.isValid()) {
+        return QString();
+    }
+    const QString root = lookAndFeel.path();
+    if (root.isEmpty()) {
+        return QString();
+    }
+    const QString found = lookAndFeel.filePath("layouts", fileName);
+    return found.startsWith(root) ? found : QString();
+}
