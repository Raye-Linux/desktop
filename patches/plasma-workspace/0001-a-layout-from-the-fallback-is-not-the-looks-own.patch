+
+class RayeLookAndFeelLayoutTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+
+    void findsTheLayoutAlookShipsItself();
+    void refusesTheLayoutReachedThroughTheFallback();
+    void refusesTheFallbacksLayoutWhenThePackageIsInvalid();
+    void leavesBreezeItsOwnLayout();
+    void returnsNothingWhenNobodyShipsALayout();
+    void kpackageStillFallsBackAtAll();
+
