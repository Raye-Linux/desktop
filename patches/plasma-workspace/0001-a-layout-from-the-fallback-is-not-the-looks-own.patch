+    QTemporaryDir m_root;
+};
--- /dev/null
+++ b/shell/raye-autotests/tst_rayelookandfeellayout.cpp
@@ -0,0 +1,163 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "tst_rayelookandfeellayout.h"
+#include "lookandfeellayout.h"
+
+#include <KPackage/PackageStructure>
+
+#include <QDir>
+#include <QFile>
+#include <QTest>
+
+QTEST_MAIN(RayeLookAndFeelLayoutTest)
+
+namespace
+{
+const QLatin1String LAYOUT("org.kde.plasma.desktop-layout.js");
+const QLatin1String BREEZE("org.kde.breeze.desktop");
+
+// The one definition of the Plasma/LookAndFeel structure this is about, taken
+// from shell/packageplugins/lookandfeel/lookandfeel.cpp. The structure plugin
+// itself is not used, so the test does not need it installed, and it does not
+// read whatever look-and-feel packages happen to be on the build machine.
+class LookAndFeelLike : public KPackage::PackageStructure
+{
+public:
+    void initPackage(KPackage::Package *package) override
+    {
+        package->removeDefinition("mainscript");
+        package->addDirectoryDefinition("layouts", QStringLiteral("layouts"));
+    }
+};
+
+void writeFile(const QString &path, const QByteArray &contents)
+{
+    QFile file(path);
+    QVERIFY2(file.open(QIODevice::WriteOnly), qPrintable(path));
+    file.write(contents);
+}
+}
+
+void RayeLookAndFeelLayoutTest::initTestCase()
+{
+    QVERIFY(m_root.isValid());
+
+    // three look-and-feel packages on disk: Breeze and a third-party look that
+    // ship a layout, and a Raye-shaped look that ships none -- which is the
+    // whole point of patch 0003 of plasma-desktop
+    const auto make = [this](const QLatin1String &id, bool withLayout) {
+        const QString dir = m_root.filePath(id);
+        QVERIFY(QDir().mkpath(dir + QStringLiteral("/contents")));
+        writeFile(dir + QStringLiteral("/metadata.json"),
+                  QStringLiteral("{\"KPlugin\":{\"Id\":\"%1\",\"Name\":\"%1\"}}").arg(id).toUtf8());
+        if (withLayout) {
+            QVERIFY(QDir().mkpath(dir + QStringLiteral("/contents/layouts")));
+            writeFile(dir + QStringLiteral("/contents/layouts/") + LAYOUT, QByteArrayLiteral("// ") + id.data());
+        }
+    };
+    make(BREEZE, true);
+    make(QLatin1String("org.third.party.desktop"), true);
+    make(QLatin1String("org.raye.night.desktop"), false);
+    make(QLatin1String("org.nobody.desktop"), false);
+}
+
+namespace
+{
+// A look-and-feel package the way ShellCorona holds one: the active package,
+// with the fallback that lookandfeel.cpp's pathChanged() gives every package
+// whose id is not org.kde.breeze.desktop.
+KPackage::Package activeLook(const QTemporaryDir &root, const QString &id)
+{
+    KPackage::Package breeze(new LookAndFeelLike);
+    breeze.setPath(root.filePath(BREEZE));
+
+    KPackage::Package look(new LookAndFeelLike);
+    look.setPath(root.filePath(id));
+    if (id != BREEZE) {
+        look.setFallbackPackage(breeze);
+    }
+    return look;
+}
+}
+
+void RayeLookAndFeelLayoutTest::findsTheLayoutAlookShipsItself()
+{
+    // a look that really carries a layout keeps it: this is not about taking
+    // the feature away from a third-party theme
+    const KPackage::Package look = activeLook(m_root, QStringLiteral("org.third.party.desktop"));
+    const QString found = ownLookAndFeelLayout(look, LAYOUT);
+    QVERIFY(!found.isEmpty());
+    QVERIFY(found.startsWith(look.path()));
+    QVERIFY(QFile::exists(found));
+}
+
+void RayeLookAndFeelLayoutTest::refusesTheLayoutReachedThroughTheFallback()
+{
+    // 🚨 the bug this patch is for: the look ships no layout, KPackage answers
+    // Breeze's, the answer is not empty, and ShellCorona therefore never looks
+    // at the shell package's own defaultlayout
+    const KPackage::Package look = activeLook(m_root, QStringLiteral("org.raye.night.desktop"));
+
+    const QString throughKPackage = look.filePath("layouts", LAYOUT);
+    QVERIFY2(!throughKPackage.isEmpty(),
+             "KPackage no longer answers out of the fallback: this test is checking nothing");
+    QVERIFY(throughKPackage.contains(BREEZE));
+
+    QVERIFY2(ownLookAndFeelLayout(look, LAYOUT).isEmpty(),
+             "the fallback's layout came through, so the shell package's defaultlayout is still "
+             "unreachable and a new account starts with upstream's taskbar");
+}
+
+void RayeLookAndFeelLayoutTest::refusesTheFallbacksLayoutWhenThePackageIsInvalid()
+{
+    // ⚠️ the corner the prefix test cannot carry on its own: an invalid package
+    // has an empty path(), QString::startsWith(QString()) is true for every
+    // string, and filePath() still answers out of the fallback
+    KPackage::Package breeze(new LookAndFeelLike);
+    breeze.setPath(m_root.filePath(BREEZE));
+
+    KPackage::Package broken(new LookAndFeelLike);
+    broken.setFallbackPackage(breeze);
+
+    QVERIFY(!broken.isValid());
+    QVERIFY(broken.path().isEmpty());
+    QVERIFY(!broken.filePath("layouts", LAYOUT).isEmpty());
+    QVERIFY(ownLookAndFeelLayout(broken, LAYOUT).isEmpty());
+}
+
+void RayeLookAndFeelLayoutTest::leavesBreezeItsOwnLayout()
+{
+    // Breeze is given no fallback at all, and must still find its own layout:
+    // a Raye desktop with the Breeze look is Breeze's desktop
+    const KPackage::Package look = activeLook(m_root, BREEZE);
+    const QString found = ownLookAndFeelLayout(look, LAYOUT);
+    QVERIFY(!found.isEmpty());
+    QVERIFY(found.startsWith(look.path()));
+}
+
+void RayeLookAndFeelLayoutTest::returnsNothingWhenNobodyShipsALayout()
+{
+    KPackage::Package look(new LookAndFeelLike);
+    look.setPath(m_root.filePath(QStringLiteral("org.nobody.desktop")));
+    QVERIFY(look.isValid());
+    QVERIFY(ownLookAndFeelLayout(look, LAYOUT).isEmpty());
+}
+
+void RayeLookAndFeelLayoutTest::kpackageStillFallsBackAtAll()
+{
+    // The patch is only needed because KPackage falls a missing file through to
+    // the fallback package. If a KPackage release ever stopped doing that, this
+    // fails and says so, rather than leaving a correction nobody can explain.
+    KPackage::Package breeze(new LookAndFeelLike);
+    breeze.setPath(m_root.filePath(BREEZE));
+
+    KPackage::Package look(new LookAndFeelLike);
+    look.setPath(m_root.filePath(QStringLiteral("org.nobody.desktop")));
+    look.setFallbackPackage(breeze);
+
+    QCOMPARE(look.filePath("layouts", LAYOUT), breeze.filePath("layouts", LAYOUT));
+}
