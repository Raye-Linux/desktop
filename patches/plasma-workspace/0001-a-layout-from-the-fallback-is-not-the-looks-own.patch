+# Raye's own tests of this shell, in a directory of their own rather than in
+# autotests/: the packaging builds with BUILD_TESTING=OFF and empties
+# dh_auto_test, and a Raye patch still has to be checked where it is built.
+# Turning the upstream directory on to reach one test would bring upstream's
+# whole suite -- and its Wayland compositor dependency -- back with it.
+#
+# Qt6::Test is asked for here on purpose: with BUILD_TESTING off nothing else
+# in the tree pulls it in. KF6::Package is already a required component of the
+# top-level project, so the test does not ask for it again.
+find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test)
+
+# lookandfeellayout.h is header-only, so the test needs none of plasmashell's
+# objects: it builds against KPackage alone, which is exactly the behaviour
+# under test.
+add_executable(tst_rayelookandfeellayout tst_rayelookandfeellayout.cpp)
+target_include_directories(tst_rayelookandfeellayout PRIVATE ..)
+target_link_libraries(tst_rayelookandfeellayout PRIVATE Qt6::Test KF6::Package)
+# the name begins with raye: that is what the package build runs
+add_test(NAME rayelookandfeellayout COMMAND tst_rayelookandfeellayout)
+set_tests_properties(rayelookandfeellayout PROPERTIES
+    TIMEOUT 60
+    ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
