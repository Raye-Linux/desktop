--- /dev/null
+++ b/shell/heaptrim.h
@@ -0,0 +1,60 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QTimer>
+
+#include <chrono>
+
+#if __has_include(<malloc.h>) && defined(__GLIBC__)
+#include <malloc.h>
+#endif
+
+/**
+ * Gives freed heap back to the system now and again.
+ *
+ * The trim threshold set in main() only returns what is free at the top of
+ * the main heap. Holes inside it, and inside the arenas of the render
+ * threads, stay counted as the shell's memory: about 30 MB once the desktop
+ * has settled. malloc_trim(0) hands those pages back; it takes a few
+ * milliseconds and the pages are faulted in again only if they are used.
+ */
+class HeapTrim : public QObject
+{
+public:
+    HeapTrim(std::chrono::milliseconds first, std::chrono::milliseconds every, QObject *parent = nullptr)
+        : QObject(parent)
+    {
+        m_timer.setSingleShot(true);
+        // no precision needed, so the wakeup can be shared. Not VeryCoarseTimer:
+        // it rounds to whole seconds, and an interval under one becomes zero.
+        m_timer.setTimerType(Qt::CoarseTimer);
+        QObject::connect(&m_timer, &QTimer::timeout, this, [this, every] {
+            trimNow();
+            ++m_passes;
+            m_timer.start(every);
+        });
+        m_timer.start(first);
+    }
+
+    int passes() const
+    {
+        return m_passes;
+    }
+
+    static void trimNow()
+    {
+#if __has_include(<malloc.h>) && defined(__GLIBC__)
+        malloc_trim(0);
+#endif
+    }
+
+private:
+    QTimer m_timer;
+    int m_passes = 0;
+};
--- /dev/null
+++ b/shell/raye-autotests/tst_rayeheaptrim.cpp
@@ -0,0 +1,92 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "heaptrim.h"
+
+#include <QFile>
+#include <QTest>
+
+#include <malloc.h>
+#include <unistd.h>
+
+#include <cstring>
+#include <vector>
+
+using namespace std::chrono_literals;
+
+static qint64 anonKiB()
+{
+    QFile status(QStringLiteral("/proc/self/status"));
+    if (!status.open(QIODevice::ReadOnly)) {
+        return -1;
+    }
+    for (const QByteArray &line : status.readAll().split('\n')) {
+        if (line.startsWith("RssAnon:")) {
+            return line.mid(8).trimmed().split(' ').value(0).toLongLong();
+        }
+    }
+    return -1;
+}
+
+class RayeHeapTrimTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        // what plasmashell's main() sets before anything else
+        mallopt(M_TRIM_THRESHOLD, 5 * sysconf(_SC_PAGESIZE));
+    }
+
+    void runsFirstThenEveryInterval()
+    {
+        HeapTrim trim(50ms, 120ms);
+        QCOMPARE(trim.passes(), 0);
+        QTRY_COMPARE_WITH_TIMEOUT(trim.passes(), 1, 2000);
+        QTRY_VERIFY_WITH_TIMEOUT(trim.passes() >= 3, 3000);
+    }
+
+    void waitsTheIntervalBetweenPasses()
+    {
+        HeapTrim trim(10ms, 300ms);
+        QTRY_COMPARE_WITH_TIMEOUT(trim.passes(), 1, 2000);
+        QTest::qWait(100);
+        QCOMPARE(trim.passes(), 1);
+    }
+
+    void givesBackHolesInTheHeap()
+    {
+        // 64 MB in 16 KB blocks, then free all but one in 64: the heap
+        // cannot shrink from the top, so the trim threshold gives nothing
+        // back and the freed pages stay counted
+        constexpr int count = 4096;
+        constexpr size_t size = 16 * 1024;
+        std::vector<char *> blocks(count);
+        for (auto &b : blocks) {
+            b = static_cast<char *>(malloc(size));
+            std::memset(b, 1, size);
+        }
+        for (int i = 0; i < count; ++i) {
+            if (i % 64 != 63) {
+                free(blocks[i]);
+                blocks[i] = nullptr;
+            }
+        }
+        const qint64 held = anonKiB();
+        HeapTrim::trimNow();
+        const qint64 after = anonKiB();
+        for (char *b : blocks) {
+            free(b);
+        }
+        QVERIFY2(held - after > 32 * 1024,
+                 qPrintable(QStringLiteral("%1 KiB before, %2 KiB after").arg(held).arg(after)));
+    }
+};
+
+QTEST_GUILESS_MAIN(RayeHeapTrimTest)
+
+#include "tst_rayeheaptrim.moc"
