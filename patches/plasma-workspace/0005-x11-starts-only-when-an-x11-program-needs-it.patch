--- a/kcms/krdb/raye-autotests/tst_rayexwaylandrunning.cpp
+++ b/kcms/krdb/raye-autotests/tst_rayexwaylandrunning.cpp
@@ -0,0 +1,67 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "xwaylandrunning.h"
+
+#include <QTemporaryDir>
+#include <QTest>
+
+class TestXwaylandRunning : public QObject
+{
+    Q_OBJECT
+
+private:
+    static void addProcess(const QString &proc, const QString &pid, const QByteArray &comm)
+    {
+        QDir(proc).mkpath(pid);
+        QFile f(proc + QLatin1Char('/') + pid + QStringLiteral("/comm"));
+        QVERIFY(f.open(QIODevice::WriteOnly));
+        f.write(comm + '\n');
+    }
+
+private Q_SLOTS:
+    void noXwayland()
+    {
+        QTemporaryDir proc;
+        addProcess(proc.path(), QStringLiteral("12"), "kwin_wayland");
+        addProcess(proc.path(), QStringLiteral("40"), "plasmashell");
+        QVERIFY(!xwaylandRunning(proc.path(), getuid()));
+    }
+
+    void xwaylandOfThisAccount()
+    {
+        QTemporaryDir proc;
+        addProcess(proc.path(), QStringLiteral("12"), "kwin_wayland");
+        addProcess(proc.path(), QStringLiteral("13"), "Xwayland");
+        QVERIFY(xwaylandRunning(proc.path(), getuid()));
+    }
+
+    void xwaylandOfAnotherAccount()
+    {
+        QTemporaryDir proc;
+        addProcess(proc.path(), QStringLiteral("13"), "Xwayland");
+        QVERIFY(!xwaylandRunning(proc.path(), getuid() + 1));
+    }
+
+    void onlyProcessFolders()
+    {
+        QTemporaryDir proc;
+        addProcess(proc.path(), QStringLiteral("self"), "Xwayland");
+        addProcess(proc.path(), QStringLiteral("12x"), "Xwayland");
+        addProcess(proc.path(), QStringLiteral("14"), "Xwayland-helper");
+        QVERIFY(!xwaylandRunning(proc.path(), getuid()));
+    }
+
+    void xServerIsUpOutsideWayland()
+    {
+        // the test runs on the offscreen platform, which is not Wayland
+        QVERIFY(xServerUp());
+    }
+};
+
+QTEST_GUILESS_MAIN(TestXwaylandRunning)
+
+#include "tst_rayexwaylandrunning.moc"
