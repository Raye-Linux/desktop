--- a/kcms/krdb/xwaylandrunning.h
+++ b/kcms/krdb/xwaylandrunning.h
@@ -0,0 +1,47 @@
+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
+#include <KWindowSystem>
+
+#include <unistd.h>
+
+/*
+ * Whether this account's Xwayland is running, read from proc. KWin starts it
+ * the first time a program connects to the display, so asking the X server
+ * itself would start it.
+ */
+inline bool xwaylandRunning(const QString &proc = QStringLiteral("/proc"), uint uid = getuid())
+{
+    const auto entries = QDir(proc).entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot);
+    for (const QFileInfo &entry : entries) {
+        bool isPid = false;
+        entry.fileName().toUInt(&isPid);
+        if (!isPid || entry.ownerId() != uid) {
+            continue;
+        }
+        QFile comm(entry.filePath() + QStringLiteral("/comm"));
+        if (comm.open(QIODevice::ReadOnly) && comm.readAll().trimmed() == "Xwayland") {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Whether X resources can be written now without starting X for them. On
+ * Wayland they are written again when Xwayland starts (Xwayland-session.d
+ * runs kcminit for these modules).
+ */
+inline bool xServerUp()
+{
+    return !KWindowSystem::isPlatformWayland() || xwaylandRunning();
+}
