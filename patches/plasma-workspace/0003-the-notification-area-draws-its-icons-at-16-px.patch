+/*
+    SPDX-FileCopyrightText: 2026 Raye Linux
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+/*
+ * The two numbers that decide how the notification area looks when the
+ * panel is not scaling its icons: how big an icon is drawn, and how thick
+ * one row of icons counts as.
+ *
+ * Upstream used ONE number for both -- Kirigami.Units.iconSizes.smallMedium,
+ * 22 -- so the icon was drawn at 22 and the number of rows was the panel's
+ * thickness divided by 22 + smallSpacing. Raye draws tray icons at
+ * iconSizes.small, 16, and that is exactly why the two have to come apart.
+ * Measured against the panel Raye itself ships, 48 px (layout.js of
+ * patches/plasma-desktop/0003), with smallSpacing = 4:
+ *
+ *     floor(48 / (22 + 4)) = 1 row      <- upstream, and what is wanted
+ *     floor(48 / (16 + 4)) = 2 rows     <- what one shared number gives
+ *
+ * So the smaller icon on its own would have split the notification area
+ * into two rows on Raye's own panel, which is the opposite of the look
+ * asked for, and it would have done it quietly. The row count therefore
+ * keeps upstream's divisor, and upstream's intent with it ("Should change
+ * to 2 rows/columns on a 56px panel"): floor(56 / 26) is still 2.
+ *
+ * Neither value is a pixel literal, and that is deliberate.
+ * Kirigami.Units.iconSizes scales with the font and the device pixel ratio
+ * (IconSizes::iconScaleFactor), so a high-density screen is handed 16
+ * logical units, not 16 physical dots. 16 is also a size the icon themes
+ * really ship -- Raye's own status/16 and the breeze it inherits from --
+ * and roundedIconSize(16) is 16, so no tray icon is drawn at a size it
+ * would have to be resampled to.
+ *
+ * This is a file of its own rather than three expressions buried in
+ * main.qml so that the numbers can be measured without a Plasma session:
+ * tests/test_tray_icon_size.py in raye/desktop loads this very file and
+ * reads them back.
+ */
+QtObject {
+    /* The size a tray icon is drawn at, with "Panel icon size: Small". */
+    readonly property int iconSize: Kirigami.Units.iconSizes.small
+
+    /*
+     * How thick one row of icons counts as when working out how many rows
+     * fit in the panel. Deliberately not iconSize -- see above.
+     */
+    readonly property int rowThickness: Kirigami.Units.iconSizes.smallMedium + Kirigami.Units.smallSpacing
+
+    /*
+     * How many rows -- columns, on a vertical panel -- of icons a panel
+     * this thick holds for this many icons. Upstream's own formula, with
+     * the divisor given a name: never more rows than there are icons, and
+     * never fewer than one.
+     */
+    function rowsFor(thickness: int, count: int): int {
+        return Math.max(1, Math.min(count, Math.floor(thickness / rowThickness)));
+    }
+}
